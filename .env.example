# Vel EIN av dei to autentiseringsmåtane:

# 1) Personleg API-token (enklast — Bearer direkte)
FIKEN_API_TOKEN=replace_with_personal_api_token

# 2) OAuth 2.0 (authorization code). Lat FIKEN_API_TOKEN stå tom/utkommentert,
#    fyll inn desse, og køyr `uv run fiken-auth` éin gong for å godkjenne i nettlesar.
#FIKEN_CLIENT_ID=replace_with_oauth_client_id
#FIKEN_CLIENT_SECRET=replace_with_oauth_client_secret
# redirect_uri MÅ vere registrert nøyaktig likt i Fiken-appen din:
#FIKEN_REDIRECT_URI=http://localhost:8473/callback
# Kvar tokena vert lagra (access + refresh):
#FIKEN_TOKEN_FILE=~/.config/fiken-mcp/tokens.json

FIKEN_COMPANY_SLUG=ditt-selskap-as
FIKEN_BASE_URL=https://api.fiken.no/api/v2
